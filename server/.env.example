# ─── Server (Render / Railway) ───────────────────────────────────────────────
NODE_ENV=production
PORT=5001

# Required in production (min 32 random characters)
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars

# MongoDB Atlas or self-hosted — never commit real credentials
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hms?retryWrites=true&w=majority

# Comma-separated frontend origins (Vercel URL). Example:
# CLIENT_ORIGIN=https://your-app.vercel.app,https://www.your-hospital.org
CLIENT_ORIGIN=https://your-frontend.vercel.app

# JWT lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Account lockout after failed logins
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Behind reverse proxy (Render/Railway set this true)
TRUST_PROXY=true

# Set true when frontend (Vercel) and API (Render) are on different domains
CROSS_SITE_COOKIES=true

# Skip demo user seeding in production
DISABLE_AUTO_SEED=true

# Optional refresh cookie name
# REFRESH_COOKIE_NAME=hms_refresh
